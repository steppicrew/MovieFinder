# Copy this file to ".env" and fill in your values.

# TMDB v3 API key — get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=YOUR_V3_KEY_HERE

# One or more library directories to scan, separated by ":" (os.pathsep on Linux).
# Example with several dirs:
#   MOVIE_DIRS=/mnt/movies:/mnt/more-movies:/home/me/Videos
MOVIE_DIRS=/path/to/movies
